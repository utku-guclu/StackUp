{
  "name": "advanced-state-management-with-redux-toolkit-quest",
  "packageManager": "yarn@4.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/frontend format && yarn workspace @advanced-state-management-with-redux-toolkit-quest/backend format",
    "lint": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/frontend lint && yarn workspace @advanced-state-management-with-redux-toolkit-quest/backend lint",
    "frontend:dev": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/frontend dev",
    "backend:serve": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/backend serve",
    "test": "yarn workspaces run test",
    "test:frontend": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/frontend test",
    "test:backend": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/backend test",
    "test:e2e": "yarn workspace @advanced-state-management-with-redux-toolkit-quest/frontend test:e2e"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.8",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.27.0"
  }
}
